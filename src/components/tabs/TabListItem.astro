---
import type { HTMLAttributes } from 'astro/types';
export interface Props {
  id: string;
  href?: string;
  initial?: boolean;
  class?: string;
}
const { id, href, initial } = Astro.props;
const linkHref = href || ('#' + id);
const linkAttributes: HTMLAttributes<'a'> = initial ? { 'data-initial': 'true' } : {};
---
<li class:list={Astro.props.class}>
  <a href={linkHref} data-tab-id={id} {...linkAttributes}><slot /></a>
</li>
